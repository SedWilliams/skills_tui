    "wrap-ansi": "^10.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
