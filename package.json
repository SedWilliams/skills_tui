{
  "name": "tui-skills",
  "version": "0.2.0",
  "description": "Find, edit, and install local coding-agent skills from your terminal",
  "type": "module",
  "bin": {
    "tui-skills": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
